# Sin DATABASE_URL la app usa PGlite (Postgres embebido) y guarda los datos en .data/pglite.
# En producción: la URL de Neon / Supabase / Vercel Postgres (con el rol dueño de la base).
# DATABASE_URL=postgres://usuario:clave@host/base?sslmode=require

# Firma de la cookie de sesión. Obligatoria en producción (≥ 32 caracteres):
#   openssl rand -hex 32
SESSION_SECRET=

# Opcionales
# MAX_DEMOS_PER_HOUR=300   # freno contra abuso del botón "Entrar a la demo"
# DB_POOL_MAX=5            # conexiones por instancia serverless
